   "source": [
    "with cte as (\n",
    "select *,\n",
    "row_number() over (partition by customer_id, department, order_date, amount order by order_date desc) as rn\n",
    " from workspace.practice.order_window\n",
    ")\n",
    "select * from cte where rn=1\n",
    " \n"
   ]
